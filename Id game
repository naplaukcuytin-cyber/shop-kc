const ALLOWED_ORIGINS = [
  "https://naplaukcuytin-cyber.github.io",
  "http://localhost:3000",
  "http://127.0.0.1:5500"
];

const API_BASE =
  "https://free-ff-api-src-5plp.onrender.com";

function cors(origin) {

  const allowed =
    ALLOWED_ORIGINS.includes(origin)
      ? origin
      : ALLOWED_ORIGINS[0];

  return {
    "Access-Control-Allow-Origin": allowed,
    "Access-Control-Allow-Methods": "GET, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type",
    "Content-Type": "application/json; charset=UTF-8",
    "Cache-Control": "no-store"
  };

}


function json(data, status, origin) {

  return new Response(
    JSON.stringify(data),
    {
      status: status,
      headers: cors(origin)
    }
  );

}


export default {

  async fetch(request) {

    const origin =
      request.headers.get("Origin") || "";

    // =========================
    // OPTIONS
    // =========================

    if (request.method === "OPTIONS") {

      return new Response(null, {
        status: 204,
        headers: cors(origin)
      });

    }


    // =========================
    // CHỈ GET
    // =========================

    if (request.method !== "GET") {

      return json(
        {
          success: false,
          error: "METHOD_NOT_ALLOWED"
        },
        405,
        origin
      );

    }


    const url =
      new URL(request.url);


    // =========================
    // PLAYER
    // =========================

    if (url.pathname !== "/player") {

      return json(
        {
          success: false,
          error: "NOT_FOUND"
        },
        404,
        origin
      );

    }


    const uid =
      (url.searchParams.get("uid") || "")
      .trim();


    let region =
      (
        url.searchParams.get("region")
        || "VN"
      ).toUpperCase();


    // =========================
    // KIỂM TRA UID
    // =========================

    if (!/^\d{5,15}$/.test(uid)) {

      return json(
        {
          success: false,
          error: "INVALID_UID"
        },
        400,
        origin
      );

    }


    // =========================
    // REGION
    // =========================

    const allowedRegions = [
      "VN",
      "SG",
      "IND",
      "ID",
      "BR",
      "TH",
      "TW",
      "US",
      "RU",
      "ME",
      "PK",
      "BD",
      "CIS"
    ];


    if (!allowedRegions.includes(region)) {

      region = "VN";

    }


    try {

      // =========================
      // GỌI FREE FIRE API
      // =========================

      const apiURL =
        API_BASE +
        "/api/v1/account" +
        "?region=" +
        encodeURIComponent(region) +
        "&uid=" +
        encodeURIComponent(uid);


      const response =
        await fetch(
          apiURL,
          {
            method: "GET",
            headers: {
              "Accept": "application/json"
            }
          }
        );


      // =========================
      // API LỖI
      // =========================

      if (!response.ok) {

        return json(
          {
            success: false,
            error: "PLAYER_API_ERROR",
            status: response.status
          },
          502,
          origin
        );

      }


      let data;

      try {

        data =
          await response.json();

      } catch {

        return json(
          {
            success: false,
            error: "INVALID_API_RESPONSE"
          },
          502,
          origin
        );

      }


      // =========================
      // TÌM BASIC INFO
      // =========================

      const basic =
        data?.basicInfo ||
        data?.basicinfo ||
        data?.data?.basicInfo ||
        data?.data?.basicinfo;


      if (!basic) {

        return json(
          {
            success: false,
            error: "PLAYER_NOT_FOUND"
          },
          404,
          origin
        );

      }


      // =========================
      // UID
      // =========================

      const playerUID =
        String(
          basic.accountId ??
          basic.accountID ??
          basic.uid ??
          uid
        );


      // =========================
      // TÊN NHÂN VẬT
      // =========================

      const nickname =
        basic.nickname ??
        basic.nickName ??
        basic.name ??
        basic.playerName ??
        basic.playerNickname;


      if (
        nickname === undefined ||
        nickname === null ||
        String(nickname).trim() === ""
      ) {

        return json(
          {
            success: false,
            error: "PLAYER_NAME_NOT_FOUND"
          },
          404,
          origin
        );

      }


      // =========================
      // SERVER
      // =========================

      const playerRegion =
        basic.region ||
        region;


      // =========================
      // LEVEL
      // =========================

      const level =
        basic.level ??
        null;


      // =========================
      // KẾT QUẢ
      // =========================

      return json(
        {
          success: true,

          uid: playerUID,

          name:
            String(nickname),

          server:
            String(playerRegion),

          level:
            level
        },
        200,
        origin
      );


    } catch (error) {

      console.error(
        "FREE FIRE PLAYER ERROR:",
        error
      );


      return json(
        {
          success: false,
          error: "SERVER_ERROR"
        },
        500,
        origin
      );

    }

  }

};
